# Скопируй в .env и поправь. Без .env всё работает в mock-режиме.
# LLM_BACKEND: mock — детерминированный бэкенд без модели; openai — любой OpenAI-совместимый сервер
LLM_BACKEND=mock
# Ollama: http://localhost:11434/v1 ; llama.cpp server / vLLM: http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=not-needed
# ASR_ENGINE: tone (T-one, основной) | gigaam (GigaAM-v3, запасной)
ASR_ENGINE=tone
